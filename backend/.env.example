POSTGRES_DB=moon
POSTGRES_USER=moon
POSTGRES_PASSWORD=change-me

# Local Keycloak container bootstrap only. Use a secret manager outside local/dev.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# One-time first system-admin bootstrap. The target identity must already exist in the moon realm.
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_ADMIN_REALM=master
MOON_REALM=moon
SYSTEM_ADMIN_USERNAME=
ALLOW_INSECURE_KEYCLOAK=true

# Real provider credentials stay outside git. Providers remain disabled until credentials exist.
SMS_PROVIDER=Disabled
SMS_API_KEY=
PAYMENT_PROVIDER=Disabled
PAYMENT_API_KEY=
PAYMENT_CALLBACK_URL=

# Local RabbitMQ. Production credentials must come from the secret manager.
RABBITMQ_DEFAULT_USER=moon
RABBITMQ_DEFAULT_PASS=change-me
Messaging__Transport=RabbitMQ
Messaging__OutboxDispatchEnabled=false
Messaging__RabbitMqHost=localhost
Messaging__RabbitMqVirtualHost=/
Messaging__RabbitMqUsername=moon
Messaging__RabbitMqPassword=
