{
    email {$TLS_CONTACT_EMAIL}
    admin off
}

# TLS is issued only after DNS and 80/443 resolve to the approved server.
# Access logging is deliberately NOT enabled: Mehrad sends its one-use code
# in the callback query string. Do not enable default raw request logging.
{$MOON_PUBLIC_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000"
    }

    # Management endpoints must not be exposed directly to the internet.
    # Operators administer Keycloak using an audited private connection.
    @admin path /identity/admin /identity/admin/*
    @api path /api/* /health/*
    @identity path /identity/*

    # Explicit ordering: a top-level respond may be sorted after handle.
    # Deny management routes before the broader identity proxy.
    route {
        respond @admin 403

        handle @api {
            reverse_proxy api:8080
        }

        handle @identity {
            reverse_proxy keycloak:8080
        }

        handle {
            reverse_proxy web:8080
        }
    }
}
