# Copy to deploy/production/.env.production on the server and chmod 600.
# These values are NOT development credentials and must NOT be committed.
# New random secrets should be generated independently per service.
MOON_PUBLIC_DOMAIN=mahcsr.ir
MOON_IMAGE_TAG=REPLACE_WITH_VERIFIED_COMMIT_SHA
TLS_CONTACT_EMAIL=REPLACE_WITH_REAL_EMAIL
MOON_DB_PASSWORD=REPLACE_WITH_NEW_RANDOM_MOON_DATABASE_PASSWORD
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_KEYCLOAK_DATABASE_PASSWORD
KEYCLOAK_ADMIN_USERNAME=REPLACE_WITH_INITIAL_ADMIN_USERNAME
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_NEW_RANDOM_KEYCLOAK_BOOTSTRAP_PASSWORD
MOON_LOGIN_OTP_OWNER_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_OTP_DATABASE_OWNER_PASSWORD
MOON_LOGIN_OTP_DB_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_OTP_APPLICATION_PASSWORD
